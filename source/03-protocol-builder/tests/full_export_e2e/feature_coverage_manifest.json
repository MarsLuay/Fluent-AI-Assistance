      "tests": ["test_feature_coverage_gaps_are_explicit"],
      "coverage": "declared_gap",
      "gap_reason": "The synthetic full-export fixture has no CGA/RGA gripper commands; covering gripper state from this fixture would be a silent synthetic success path."
    }
