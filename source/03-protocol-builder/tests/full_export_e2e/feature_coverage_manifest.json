      "tests": ["test_project_reader_against_full_export", "test_cli_entry_points_against_full_export"]
    },
    {
      "id": "pipeline.pattern_library",
      "tests": ["test_project_reader_against_full_export"]
    },
    {
      "id": "pipeline.request_spec",
      "tests": ["test_full_export_workflow_completes", "test_full_export_negative_paths"]
    },
    {
      "id": "pipeline.protocol_ir",
      "tests": ["test_full_export_workflow_completes", "test_full_export_negative_paths"]
