{
  "$id": "https://fluent-ai-assistance.local/templates/tip_strategy_test/request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "request": {
      "properties": {
        "intent": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "intent"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "tecan.request_spec.v1"
    },
    "template": {
      "properties": {
        "name": {
          "const": "tip_strategy_test"
        },
        "parameters": {
          "properties": {
            "water_reservoir": {"type": "string"},
            "test_plate": {"type": "string"},
            "tip_box": {"type": "string"},
            "return_tip_box": {"type": "string"},
            "waste": {"type": "string"},
            "liquid_class": {"type": "string"},
            "worktable": {"type": "string"},
            "allow_tip_reuse": {
              "type": "boolean"
            },
            "test_volume_ul": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "tip_strategy": {
              "enum": [
                "fresh_only",
                "return_for_reuse",
                "drop_to_waste"
              ],
              "type": "string"
            },
            "wash_scheme": {
              "type": "string"
            }
          },
          "required": [
            "water_reservoir",
            "test_plate",
            "tip_box",
            "return_tip_box",
            "waste",
            "liquid_class",
            "test_volume_ul",
            "tip_strategy",
            "wash_scheme"
          ],
          "type": "object"
        }
      },
      "required": [
        "name",
        "parameters"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "request",
    "template"
  ],
  "title": "Tip Strategy Test Template Request",
  "type": "object"
}
