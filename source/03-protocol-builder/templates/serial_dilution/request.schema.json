{
  "$id": "https://fluent-ai-assistance.local/templates/serial_dilution/request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "request": {
      "properties": {
        "intent": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "intent"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "tecan.request_spec.v1"
    },
    "template": {
      "properties": {
        "name": {
          "const": "serial_dilution"
        },
        "parameters": {
          "properties": {
            "source_plate": {"type": "string"},
            "dilution_plate": {"type": "string"},
            "diluent_reservoir": {"type": "string"},
            "tip_box": {"type": "string"},
            "worktable": {"type": "string"},
            "diluent_volume_ul": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "dilution_count": {
              "minimum": 2,
              "type": "integer"
            },
            "liquid_class": {
              "type": "string"
            },
            "mix_cycles": {
              "minimum": 1,
              "type": "integer"
            },
            "sample_volume_ul": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "required": [
            "source_plate",
            "dilution_plate",
            "diluent_reservoir",
            "tip_box",
            "sample_volume_ul",
            "diluent_volume_ul",
            "dilution_count",
            "liquid_class"
          ],
          "type": "object"
        }
      },
      "required": [
        "name",
        "parameters"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "request",
    "template"
  ],
  "title": "Serial Dilution Template Request",
  "type": "object"
}
