    },
    {
      "id": "manual_validation_required",
      "text": "Generated artifacts must be reviewed, simulated, and validated in FluentControl before instrument use."
    }
  ],
  "source": {
    "format": "template_protocol",
    "path": "templates/normalization/template.ir.json",
    "template": "normalization"
  },
  "steps": [
    {
      "group": "Setup",
      "id": "step_001",
      "index": 1,
      "name": "Add Input Plate",
      "operation": "add_labware",
      "parameters": {
        "label": "input_plate",
        "labware_type": "",
        "location": "",
        "position": null
      },
      "target_labware": "input_plate"
    },
    {
      "group": "Setup",
      "id": "step_002",
      "index": 2,
      "name": "Add Normalized Plate",
      "operation": "add_labware",
      "parameters": {
        "label": "normalized_plate",
        "labware_type": "",
        "location": "",
        "position": null
      },
      "target_labware": "normalized_plate"
    },
    {
      "group": "Setup",
      "id": "step_003",
      "index": 3,
      "name": "Add Diluent Reservoir",
      "operation": "add_labware",
      "parameters": {
        "label": "diluent_reservoir",
        "labware_type": "",
        "location": "",
        "position": null
      },
      "target_labware": "diluent_reservoir"
    },
    {
      "group": "Setup",
      "id": "step_004",
      "index": 4,
      "name": "Add Tip Box",
      "operation": "add_labware",
      "parameters": {
        "label": "tips",
        "labware_type": "",
        "location": "",
        "position": null
      },
      "target_labware": "tips"
    },
    {
      "group": "Normalize",
      "id": "step_005",
      "index": 5,
      "name": "Pick Up tips",
      "operation": "pick_up_tips",
      "parameters": {
        "tip_strategy": "new_tips"
      },
      "target_labware": "tips"
    },
    {
      "group": "Normalize",
      "id": "step_006",
      "index": 6,
      "liquid_class": "__GROUND_FROM_CONTEXT__",
      "name": "Aspirate Sample Volume",
      "operation": "aspirate",
      "parameters": {
        "source_well": "A1"
      },
      "source_labware": "input_plate",
      "target_labware": "input_plate",
      "volume_ul": 5
    },
    {
      "destination_labware": "normalized_plate",
      "group": "Normalize",
      "id": "step_007",
      "index": 7,
      "liquid_class": "__GROUND_FROM_CONTEXT__",
      "name": "Dispense Sample",
      "operation": "dispense",
      "parameters": {
        "destination_well": "A1"
      },
      "target_labware": "normalized_plate",
      "volume_ul": 5
    },
    {
      "group": "Normalize",
      "id": "step_008",
      "index": 8,
      "liquid_class": "__GROUND_FROM_CONTEXT__",
      "name": "Aspirate Diluent",
      "operation": "aspirate",
      "parameters": {
        "source_well": "A1"
      },
      "source_labware": "diluent_reservoir",
      "target_labware": "diluent_reservoir",
      "volume_ul": 45
    },
    {
      "destination_labware": "normalized_plate",
      "group": "Normalize",
      "id": "step_009",
      "index": 9,
      "liquid_class": "__GROUND_FROM_CONTEXT__",
      "name": "Dispense Diluent",
      "operation": "dispense",
      "parameters": {
        "destination_well": "A1"
      },
      "target_labware": "normalized_plate",
      "volume_ul": 45
    },
    {
      "group": "Normalize",
      "id": "step_010",
      "index": 10,
      "liquid_class": "__GROUND_FROM_CONTEXT__",
      "name": "Mix Normalized Sample",
      "operation": "mca384_mix",
      "parameters": {
        "cycles": 8,
        "well": "A1"
      },
      "target_labware": "normalized_plate",
      "volume_ul": 35
    },
    {
      "group": "Cleanup",
      "id": "step_011",
      "index": 11,
      "name": "Return tips",
      "operation": "set_tips_back",
      "parameters": {
        "tip_strategy": "return_to_source"
      },
      "target_labware": "tips"
    }
  ],
  "template": {
    "description": "Sample normalization workflow with calculated sample volume, diluent fill, and mix.",
    "name": "normalization",
    "request_schema": "request.schema.json",
